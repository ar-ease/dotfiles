# ═══════════════════════════════════════════════════════════════
#  Ghostty config — tuned for Claude Code & Codex
#  Needs Ghostty 1.3+ for notify-on-command-finish
# ═══════════════════════════════════════════════════════════════

# ───── Theme ─────
background = #1C1E26
# Alternates: #181818 #1E1E1E #0F0F0F #22252B #1E1F26
background-opacity = .95
background-blur-radius = 90

# ───── Font ─────
font-family = "MesloLGS Nerd Font"
# Alternates: JetBrainsMono / CaskaydiaCove / Hack / Mononoki / Iosevka /
#             VictorMono / SourceCodePro / FiraCode / Monaspice Xe Nerd Font Mono
font-size = 15
font-feature = "+calt +liga +dlig"

# ───── Cursor ─────
cursor-style = "block"
cursor-style-blink = false
cursor-invert-fg-bg = true

# ───── macOS ─────
macos-titlebar-style = "transparent"
# Lets Option work as Alt/Meta (Claude Code & Codex shortcuts like Option+P, Option+Enter)
macos-option-as-alt = true

# ───── Behavior ─────
mouse-hide-while-typing = true
# CHANGED: ask before closing a tab/split that still has a running process,
# so you don't kill a Claude/Codex session by accident. Idle shells close instantly.
confirm-close-surface = true
copy-on-select = "clipboard"
working-directory = "/Users/ar-ease"
window-inherit-working-directory = true
# CHANGED: this value is in BYTES, not lines. 10000 was only ~10 KB, so long
# agent output got cut off. 100 MB per surface keeps full sessions scrollable.
scrollback-limit = 100000000

# ───── Clipboard (agents copy via OSC 52) ─────
clipboard-read = ask
clipboard-write = allow

# ───── Shell Integration ─────
# Enables prompt marks (jump between prompts), command-finish detection and titles.
# no-cursor keeps your block cursor instead of switching to a bar at the prompt.
shell-integration = detect
shell-integration-features = no-cursor,sudo,no-title

# ───── Notifications ─────
# Allow apps (Claude Code, Codex) to raise macOS notifications via OSC 9 / OSC 777
desktop-notifications = true
# Notify when a long command finishes while Ghostty isn't focused
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify
notify-on-command-finish-after = 30s
# Bell = sound + Dock bounce + tab title mark (Ghostty banners themselves are silent)
bell-features = audio,no-system,attention,title
bell-audio-path = /System/Library/Sounds/Ping.aiff
bell-audio-volume = 0.6

# ───── Window ─────
window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-save-state = "always"
window-new-tab-position = "current"

# ───── Updates ─────
auto-update = "check"
auto-update-channel = "stable"

# ───── Keybindings ─────
keybind = ctrl+i=text:\x1b[73;5u

# Core actions
keybind = "super+i=inspector:toggle"
keybind = "super+b>r=reload_config"
keybind = "super+b>x=close_surface"
keybind = "super+b>c=new_tab"
keybind = "super+b>n=new_window"

# Tab switching
keybind = "super+b>1=goto_tab:1"
keybind = "super+b>2=goto_tab:2"
keybind = "super+b>3=goto_tab:3"
keybind = "super+b>4=goto_tab:4"
keybind = "super+b>5=goto_tab:5"
keybind = "super+b>6=goto_tab:6"
keybind = "super+b>7=goto_tab:7"
keybind = "super+b>8=goto_tab:8"
keybind = "super+b>9=goto_tab:9"

# Splits
keybind = "super+b>backslash=new_split:right"
keybind = "super+b>minus=new_split:down"
keybind = "super+b>e=equalize_splits"
# NEW: zoom the current split full-window (handy for reading a long agent diff)
keybind = "super+b>z=toggle_split_zoom"

# Split navigation
keybind = "super+h=goto_split:left"
keybind = "super+j=goto_split:down"
keybind = "super+k=goto_split:up"
keybind = "super+l=goto_split:right"
keybind = "global:super+shift+h=goto_split:left"
keybind = "global:super+shift+j=goto_split:down"
keybind = "global:super+shift+k=goto_split:up"
keybind = "global:super+shift+l=goto_split:right"

# NEW: jump between prompts (skip past long agent output)
keybind = "super+up=jump_to_prompt:-1"
keybind = "super+down=jump_to_prompt:1"

# NEW: resize the current split (hold super+ctrl, tap h/j/k/l repeatedly)
keybind = "super+ctrl+h=resize_split:left,150"
keybind = "super+ctrl+j=resize_split:down,150"
keybind = "super+ctrl+k=resize_split:up,150"
keybind = "super+ctrl+l=resize_split:right,150"
keybind = "super+ctrl+left=resize_split:left,40"
keybind = "super+ctrl+down=resize_split:down,40"
keybind = "super+ctrl+up=resize_split:up,40"
keybind = "super+ctrl+right=resize_split:right,40"

# Keyboard scrolling (Mac has no Home/PgUp keys without fn)
keybind = "super+alt+k=scroll_page_lines:-3"
keybind = "super+alt+j=scroll_page_lines:3"
keybind = "super+alt+u=scroll_page_fractional:-0.5"
keybind = "super+alt+d=scroll_page_fractional:0.5"
keybind = "super+alt+g=scroll_to_top"
keybind = "super+alt+shift+g=scroll_to_bottom"
